# macOS
.DS_Store

# 인증 정보 — 절대 커밋 금지
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json

# 빌드 산출물
# build/ 는 빌드 "스크립트" 디렉터리라 커밋 대상이다. 제외하지 않는다.
dist/
*.alfredworkflow
# info.plist 는 build/info_plist.py 가 생성한다. 생성물을 커밋하면 Alfred UI 에서
# 편집한 내용과 갈라져 어느 쪽이 정본인지 알 수 없게 된다.
workflow/info.plist
# 아이콘도 build/icons.py 가 생성한다.
# 아이콘 PNG 도 산출물이다. 원본은 assets/icons/*.svg.
workflow/icons/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/

# IDE
.idea/
.vscode/

# OMC 런타임 상태 (하위 디렉터리에 생기는 것까지)
.omc/
